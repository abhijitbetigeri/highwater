# ─────────────────────────────────────────────────────────────────────────────
# asof — environment
#
# Nothing here is needed for `npm run demo`. The demo is offline by design:
# no network, no model call, no database. These keys are for the live paths.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon — the memory. REQUIRED for any live path. ──────────────────────────
# Postgres + pgvector. The facts store and the decayed read both live here.
DATABASE_URL=
# Branch used for what-if replays ("what would asof have decided last Tuesday?").
# Create with: neonctl branches create --name replay
DATABASE_URL_REPLAY=

# Neon AI Gateway — models and embeddings behind one key.
NEON_AI_GATEWAY_BASE_URL=           # bare host, no path; append /v1 yourself
NEON_AI_GATEWAY_API_KEY=

# ── Exa — the market sensor. REQUIRED for live price/capacity facts. ────────
# Crawls provider pricing + availability pages. Output is written to Neon as
# dated facts of kind `price` / `capacity`, never injected raw into a prompt.
EXA_API_KEY=

# ── Fly.io — the probe sandbox and the agent body. REQUIRED for probing. ────
# 60-second profiling run that measures real VRAM high-water and step time.
# This is what generates `vram_ceiling` / `step_time` facts.
FLY_API_TOKEN=
FLY_APP_NAME=asof-probe
FLY_ORG=personal

# ── Executor — tool/MCP gateway. REQUIRED to submit real jobs. ─────────────
# Policy derives from protocol: reads autonomous, writes gated.
# Provider credentials live here and never enter model context.
EXECUTOR_MCP_URL=
EXECUTOR_API_KEY=

# ── AgentMail — the broker's own inbox. REQUIRED for notify + reply-to-act. ─
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
OWNER_EMAIL=                        # where checkpoints and escalations go

# ── Kernel — cloud browser. OPTIONAL; cut first under time pressure. ───────
# For the consoles with no API at all: quota pages, billing, capacity dashboards.
KERNEL_API_KEY=

# ── Mastra — runtime + observability. ──────────────────────────────────────
# Local dev needs no key. Set this only for hosted traces.
MASTRA_CLOUD_API_KEY=

# ── Compute providers. Needed only for the ones you actually place onto. ───
# Held by Executor in production; here for local dry-runs only.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
LAMBDA_API_KEY=
RUNPOD_API_KEY=
HF_TOKEN=
TOGETHER_API_KEY=

# ── Voice (narration track) ─────────────────────────────────────────────────
# ElevenLabs. Scoped key is fine — TTS permission only, no user_read needed.
# Falls back to ~/projects/mise/.env if left blank.
ELEVENLABS_API_KEY=
